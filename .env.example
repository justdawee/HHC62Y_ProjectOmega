# SmartPantry environment variables
# Copy this file to .env and fill in real values; .env is gitignored.

# Required: OpenAI API key for LLM recipe generation.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Optional: which OpenAI chat model to use. Default is gpt-5.4-mini, the
# sweet spot of "cheap but smart" (~$0.75 / $4.50 per 1M tokens at the time
# of writing). Bump to gpt-5.4 for higher quality, drop to gpt-5.4-nano for
# even cheaper completion (smaller model, less coherent multi-step prose).
# OPENAI_MODEL=gpt-5.4-mini

# Optional: override default DB location (inside the container)
# DB_PATH=/data/smartpantry.db

# Optional: TheMealDB API key. The free public test key "1" is used by
# default and is sufficient for development; supporters can upgrade their
# key on themealdb.com for higher rate limits and the multi-ingredient
# filter endpoint.
# MEALDB_KEY=1
