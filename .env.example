# SmartPantry environment variables
# Copy this file to .env and fill in real values; .env is gitignored.

# Required: Groq API key for LLM recipe generation
# Sign up at https://console.groq.com/ to get a free API key.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: override default DB location (inside the container)
# DB_PATH=/data/smartpantry.db

# Optional: Pollinations.ai token for AI-generated recipe images.
# As of mid-2026 the public free endpoint requires a Cloudflare Turnstile
# challenge, so without an authenticated token the app gracefully falls
# back to a procedural gradient + emoji decoration on the recipe card.
# POLLINATIONS_TOKEN=
