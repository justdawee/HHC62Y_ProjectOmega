<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Strings.fs" />
    <Compile Include="Catalog.fs" />
    <Compile Include="Validation.fs" />
    <Compile Include="Database.fs" />
    <Compile Include="MealDbClient.fs" />
    <Compile Include="LlmClient.fs" />
    <Compile Include="Remoting.fs" />
    <Compile Include="Client.fs" />
    <Compile Include="Site.fs" />
    <Compile Include="Startup.fs" />
    <Content Include="Main.html" CopyToPublishDirectory="Always" />
    <None Include="package.json" />
    <None Include="package-lock.json" />
    <None Include="esbuild.config.mjs" />
    <None Include="vite.config.js" />
    <None Include="wsconfig.json" />
    <None Include="tailwind.config.js" />
    <None Include="styles\input.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="WebSharper" Version="10.1.0.667" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.0.667" />
    <PackageReference Include="WebSharper.UI" Version="10.1.0.667" />
    <PackageReference Include="WebSharper.AspNetCore" Version="10.1.0.667" />
  </ItemGroup>

  <!-- Install npm packages once (or whenever package.json changes). -->
  <Target Name="NpmInstall"
          BeforeTargets="TailwindBuild;WebSharperCompile;Build"
          Inputs="package.json"
          Outputs="node_modules/.package-lock.json">
    <Exec Command="npm install --no-audit --no-fund" />
  </Target>

  <!-- Compile Tailwind CSS to wwwroot/css/output.css before WebSharper compiles. -->
  <Target Name="TailwindBuild"
          BeforeTargets="WebSharperCompile;Build"
          DependsOnTargets="NpmInstall"
          Inputs="styles/input.css;tailwind.config.js;Main.html;Client.fs;Site.fs"
          Outputs="wwwroot/css/output.css">
    <Exec Command="npx tailwindcss -i ./styles/input.css -o ./wwwroot/css/output.css --minify"
          Condition=" '$(Configuration)' == 'Release' " />
    <Exec Command="npx tailwindcss -i ./styles/input.css -o ./wwwroot/css/output.css"
          Condition=" '$(Configuration)' != 'Release' " />
  </Target>

  <Target Name="ESBuildBundle" AfterTargets="WebSharperCompile" Condition=" '$(Configuration)' == 'Release' ">
    <Exec Command="node ./esbuild.config.mjs" />
  </Target>

</Project>